#version 450

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_control_flow_attributes : enable

#include "tq1_0r_1024_common.glsl"

// Rotates the activation like rot_y_tq1_0r_1024.comp (y' = (1/32) H_1024 (S1024 * y)) and quantizes it to int8
// for mul_mat_vec_tq1_0r_1024_q8.comp (4 x int8 dot products). One scale per quarter (256 elements): after the
// Hadamard rotation the activation has no outliers, and all the 5 elements of a weight byte lie in the same quarter,
// so an int8 x int8 product never mixes scales.
//
// Output per column and per block of 1024 (264 uints):
//   [0, 256)   the 1024 int8 in natural element order (4 per uint, element e in byte e % 4 of uint e / 4);
//   [256, 260) unused;
//   [260, 264) float scale (bits) of quarter q.

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) writeonly buffer D {uint data_d[];};

layout (push_constant) uniform parameter {
    uint ne;
} p;

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

shared float sh[1024];
shared float red[256];

int q8(const float v, const float inv) {
    return clamp(int(round(v * inv)), -127, 127);
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint nblk = p.ne / 1024u;
    for (uint blk = gl_WorkGroupID.x; blk < nblk; blk += gl_NumWorkGroups.x) {
        const uint base = blk * 1024u;
        for (uint e = tid; e < 1024u; e += 256u) {
            sh[e] = data_a[base + e] * (tq1_0r_1024_sign(e) * 0.03125);
        }
        barrier();
        for (uint s = 0u; s < 10u; ++s) {
            const uint len = 1u << s;
            for (uint pi = tid; pi < 512u; pi += 256u) {
                const uint i = ((pi >> s) << (s + 1u)) | (pi & (len - 1u));
                const uint j = i | len;
                const float u = sh[i];
                const float w = sh[j];
                sh[i] = u + w;
                sh[j] = u - w;
            }
            barrier();
        }
        // massimo assoluto per quarto: il thread tid guarda gli elementi 4tid..4tid+3 (quarto tid/64)
        red[tid] = max(max(abs(sh[4u * tid]), abs(sh[4u * tid + 1u])), max(abs(sh[4u * tid + 2u]), abs(sh[4u * tid + 3u])));
        barrier();
        for (uint st = 32u; st > 0u; st >>= 1) {
            if ((tid & 63u) < st) {
                red[tid] = max(red[tid], red[tid + st]);
            }
            barrier();
        }
        const uint ob = blk * 264u;
        {
            // natural order: word tid holds the int8 of the elements 4 tid .. 4 tid + 3 (quarter tid / 64)
            const float amax = red[(tid >> 6) * 64u];
            const float inv = amax > 0.0 ? 127.0 / amax : 0.0;
            uint pk = 0u;
            [[unroll]] for (uint k = 0u; k < 4u; ++k) {
                pk |= (uint(q8(sh[4u * tid + k], inv)) & 255u) << (8u * k);
            }
            data_d[ob + tid] = pk;
        }
        if (tid < 4u) {
            data_d[ob + 260u + tid] = floatBitsToUint(red[tid * 64u] / 127.0);
        }
        barrier();   // il prossimo blocco (grid-stride) riusa sh[] e red[]
    }
}
