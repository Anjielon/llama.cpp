#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

#include "mul_mat_vec_base.glsl"

// Mat-vec of TQ1_0R_1024 and its packed planes with int8 dot products. The activation arrives rotated and quantized
// by rot_q8_tq1_0r_1024.comp, in the byte order of the weights (264 uints per block). A shared table gives the digits
// t = 0..3 of each weight byte as 4 int8 {0,1,2}, then one dotPacked4x8 per byte; digit t = 4 of the 4 bytes of a word
// is assembled from 4 shifted tables for a fifth product. trit = x - 1: the sum of the int8 is subtracted per word.

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer AW {uint data_aw[];};

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

const uint TQ1R_WORDS = 56u;
const uint YQ_WORDS = 264u;

shared uint lut_a[256];      // cifre 0..3 del byte b come 4 int8
shared uint lut_b[4][256];   // cifra 4 del byte b spostata nel byte k

uint xi_digit(const uint b, const uint t) {
    const uint pow3[5] = uint[5](1u, 3u, 9u, 27u, 81u);
    return (((b * pow3[t]) & 255u) * 3u) >> 8;
}

float plane_q8(const uint w, const uint dw, const bool c1,
               const int Y0, const int Y1, const int Y2, const int Y3, const int Yb, const int sY, const int sYb) {
    const uint b0 = w & 255u, b1 = (w >> 8) & 255u, b2 = (w >> 16) & 255u, b3 = w >> 24;
    const int ilo = dotPacked4x8EXT(int(lut_a[b0]), Y0) + dotPacked4x8EXT(int(lut_a[b1]), Y1) +
                    dotPacked4x8EXT(int(lut_a[b2]), Y2) + dotPacked4x8EXT(int(lut_a[b3]), Y3) - sY;
    const int ihi = dotPacked4x8EXT(int(lut_b[0][b0] | lut_b[1][b1] | lut_b[2][b2] | lut_b[3][b3]), Yb) - sYb;
    const vec2 dd = unpackHalf2x16(dw);
    return c1 ? (dd.x * float(ilo) + dd.y * float(ihi)) : (dd.y * float(ilo + ihi));
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint nb = p.ncols / 1024u;
    const uint tid = gl_LocalInvocationID.x;
    // b_offset e i passi di colonna sono in elementi dell'attivazione originale (K per colonna):
    // qui la colonna occupa nb * 264 uint.
    const uint ycol0 = (b_offset / p.ncols) * nb * YQ_WORDS;
    const uint ycols = (p.batch_stride_b / p.ncols) * nb * YQ_WORDS;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    const uint nws = nb * 52u;
    for (uint f = tid; f < nws; f += BLOCK_SIZE) {
        const uint blk = f / 52u;
        const uint ws  = f - blk * 52u;
        const uint q   = ws / 13u;
        const uint r   = ws - q * 13u;
        const bool c1  = r < 8u;
        const uint wword = r < 12u ? (q * 12u + r) : (48u + q);

        [[unroll]] for (uint jcol = 0; jcol < NUM_COLS; ++jcol) {
            const uint yb = ycol0 + jcol * ycols + blk * YQ_WORDS;
            const int Y0 = int(data_b[yb + 4u * ws]);
            const int Y1 = int(data_b[yb + 4u * ws + 1u]);
            const int Y2 = int(data_b[yb + 4u * ws + 2u]);
            const int Y3 = int(data_b[yb + 4u * ws + 3u]);
            const int Yb = int(data_b[yb + 208u + ws]);
            const float ys = uintBitsToFloat(data_b[yb + 260u + q]);
            const int ones = 0x01010101;
            const int sY  = dotPacked4x8EXT(Y0, ones) + dotPacked4x8EXT(Y1, ones) + dotPacked4x8EXT(Y2, ones) + dotPacked4x8EXT(Y3, ones);
            const int sYb = dotPacked4x8EXT(Yb, ones);

            [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
                if (n >= num_rows) {
                    break;
                }
                // packed planes of one block are consecutive base blocks
                const uint wb = ((a_offset + (first_row + n) * nb + blk) * PACKED_K) * TQ1R_WORDS;
                float acc = 0.0;
                [[unroll]] for (uint pk = 0u; pk < PACKED_K; ++pk) {
                    acc += plane_q8(data_aw[wb + pk * TQ1R_WORDS + wword], data_aw[wb + pk * TQ1R_WORDS + 52u + q], c1, Y0, Y1, Y2, Y3, Yb, sY, sYb);
                }
                temp[jcol][n] += FLOAT_TYPE(ys * acc);
            }
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    // tabelle delle cifre (una volta per workgroup)
    for (uint i = gl_LocalInvocationID.x; i < 256u; i += BLOCK_SIZE) {
        lut_a[i] = xi_digit(i, 0u) | (xi_digit(i, 1u) << 8) | (xi_digit(i, 2u) << 16) | (xi_digit(i, 3u) << 24);
        const uint d4 = xi_digit(i, 4u);
        lut_b[0][i] = d4; lut_b[1][i] = d4 << 8; lut_b[2][i] = d4 << 16; lut_b[3][i] = d4 << 24;
    }
    barrier();

    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
