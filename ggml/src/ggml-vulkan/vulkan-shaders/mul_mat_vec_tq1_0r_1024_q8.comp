#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

#include "mul_mat_vec_base.glsl"

// Mat-vec of TQ1_0R_1024 and its packed planes with int8 dot products. The activation arrives rotated and quantized
// by rot_q8_tq1_0r_1024.comp: int8 in natural element order (264 uints per block, scale of quarter q at 260 + q).
//
// Unit of work: one 32-bit word of a block (52 per block: 48 of qs, 4 of qh). For digit t the 4 bytes of a word
// cover 4 consecutive elements, i.e. one uint of the int8 activation. The digits of the 4 bytes are decoded in
// registers (no table, no shared memory): with bytes 0,2 and 1,3 in two words of 16-bit fields, c_(t+1) = 3 c_t mod
// 256 and digit_t = (3 c_t) >> 8 is bits 8..9 of the field (3 * 255 < 1024, bits 10..15 stay zero), so the 4
// digits of step t are already in the 4 bytes of ((m02 >> 8) & 0x00FF00FF) | (m13 & 0xFF00FF00): one int8x4 for
// dotPacked4x8EXT. trit = x - 1: the sum of the activation int8 of the word is subtracted once per plane.

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer AW {uint data_aw[];};

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

const uint TQ1R_WORDS = 56u;
const uint YQ_WORDS = 264u;

// one Horner step of the SWAR decode: returns the 4 digits (int8x4) of step t and advances the state
int tq1_digits_step(inout uint w02, inout uint w13) {
    const uint m02 = (w02 << 1) + w02;
    const uint m13 = (w13 << 1) + w13;
    w02 = m02 & 0x00FF00FFu;
    w13 = m13 & 0x00FF00FFu;
    return int(((m02 >> 8) & 0x00FF00FFu) | (m13 & 0xFF00FF00u));
}

// contribution of one word of one plane, before the activation scale
float plane_q8(const uint w, const uint dw, const bool c1,
               const int Y0, const int Y1, const int Y2, const int Y3, const int Y4, const int sY, const int sY4) {
    uint w02 = w & 0x00FF00FFu;
    uint w13 = (w >> 8) & 0x00FF00FFu;
    const int D0 = tq1_digits_step(w02, w13);
    const int D1 = tq1_digits_step(w02, w13);
    const int D2 = tq1_digits_step(w02, w13);
    const int D3 = tq1_digits_step(w02, w13);
    const int D4 = tq1_digits_step(w02, w13);
    const int ilo = dotPacked4x8EXT(D0, Y0) + dotPacked4x8EXT(D1, Y1) + dotPacked4x8EXT(D2, Y2) + dotPacked4x8EXT(D3, Y3) - sY;
    const int ihi = dotPacked4x8EXT(D4, Y4) - sY4;
    const vec2 dd = unpackHalf2x16(dw);
    return c1 ? (dd.x * float(ilo) + dd.y * float(ihi)) : (dd.y * float(ilo + ihi));
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint nb = p.ncols / 1024u;
    const uint tid = gl_LocalInvocationID.x;
    // b_offset and the column strides count elements of the original activation (K per column):
    // here a column takes nb * 264 uints.
    const uint ycol0 = (b_offset / p.ncols) * nb * YQ_WORDS;
    const uint ycols = (p.batch_stride_b / p.ncols) * nb * YQ_WORDS;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

#ifdef MUL_MAT_ID
    // a skipped slot (id -1) reads nothing: the row is zeroed by reduce_result
    const uint nws = expert_skip ? 0u : nb * 52u;
#else
    const uint nws = nb * 52u;
#endif
    for (uint f = tid; f < nws; f += BLOCK_SIZE) {
        const uint blk = f / 52u;
        const uint ws  = f - blk * 52u;
        const uint q   = ws / 13u;
        const uint r   = ws - q * 13u;
        const bool c1   = r < 8u;
        const bool has5 = r < 12u;
        const uint wword = has5 ? (q * 12u + r) : (48u + q);
        // first activation uint of the word and the step between digits (uints): 32, 16 or 4 elements
        const uint y0 = q * 64u + (c1 ? r : (has5 ? 40u + (r - 8u) : 60u));
        const uint ys = c1 ? 8u : (has5 ? 4u : 1u);

        [[unroll]] for (uint jcol = 0; jcol < NUM_COLS; ++jcol) {
            const uint yb = ycol0 + jcol * ycols + blk * YQ_WORDS;
            const int Y0 = int(data_b[yb + y0]);
            const int Y1 = int(data_b[yb + y0 + ys]);
            const int Y2 = int(data_b[yb + y0 + 2u * ys]);
            const int Y3 = int(data_b[yb + y0 + 3u * ys]);
            // no branch: a qh word (4 digits) reads a valid uint and drops it
            const int Y4l = int(data_b[yb + y0 + (has5 ? 4u * ys : 0u)]);
            const int Y4 = has5 ? Y4l : 0;
            const float yscale = uintBitsToFloat(data_b[yb + 260u + q]);
            const int ones = 0x01010101;
            const int sY  = dotPacked4x8EXT(Y0, ones) + dotPacked4x8EXT(Y1, ones) + dotPacked4x8EXT(Y2, ones) + dotPacked4x8EXT(Y3, ones);
            const int sY4 = dotPacked4x8EXT(Y4, ones);

            [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
                if (n >= num_rows) {
                    break;
                }
                // packed planes of one block are consecutive base blocks
                const uint wb = ((a_offset + (first_row + n) * nb + blk) * PACKED_K) * TQ1R_WORDS;
                float acc = 0.0;
                [[unroll]] for (uint pk = 0u; pk < PACKED_K; ++pk) {
                    acc += plane_q8(data_aw[wb + pk * TQ1R_WORDS + wword], data_aw[wb + pk * TQ1R_WORDS + 52u + q], c1,
                                    Y0, Y1, Y2, Y3, Y4, sY, sY4);
                }
                temp[jcol][n] += FLOAT_TYPE(yscale * acc);
            }
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
